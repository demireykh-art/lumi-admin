rules_version = '2';
// 규칙 변경 시 main 푸시 → GitHub Actions(Deploy Firestore Rules)로 자동 배포됨.
// (자동 배포 워크플로우 검증)
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한(직원) 사용자만 접근 — 비로그인/공개 접근 전면 차단
    function signedIn() { return request.auth != null; }

    // 관리자 판별 — settings/bizAdmins.emails 화이트리스트에 포함된 로그인 이메일
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/bizAdmins)
        && (request.auth.token.email in get(/databases/$(database)/documents/settings/bizAdmins).data.emails);
    }

    // ══════════════════════════════════════════════════════════════════
    //  공개 홈페이지(lumiclinic.co.kr, 비로그인 방문자) — 콘텐츠는 누구나 "읽기"만
    //  · 쓰기는 여전히 로그인(직원/관리자) 전용
    //  · 홈페이지가 이 컬렉션을 익명으로 읽어 시술안내·이벤트·B&A·의료진 등을 표시
    // ══════════════════════════════════════════════════════════════════
    match /doctors/{id}        { allow read: if true; allow write: if signedIn(); }
    match /solutions/{id}      { allow read: if true; allow write: if signedIn(); }
    match /events/{id}         { allow read: if true; allow write: if signedIn(); }
    match /treatmentCards/{id} { allow read: if true; allow write: if signedIn(); }
    match /equipment/{id}      { allow read: if true; allow write: if signedIn(); }
    match /ba_items/{id}       { allow read: if true; allow write: if signedIn(); }
    match /schedules/{id}      { allow read: if true; allow write: if signedIn(); }
    match /activities/{id}     { allow read: if true; allow write: if signedIn(); }  // 학술활동(activity.html에 표시)

    // 단축 URL: 공개 읽기(리다이렉트) + 클릭수 갱신, 생성/삭제는 직원
    match /shortUrls/{id} {
      allow read:           if true;
      allow update:         if true;   // go.html 클릭 카운트 증가
      allow create, delete: if signedIn();
    }

    // 예약 신청: 누구나 생성(신청) 가능, 조회/변경/삭제는 직원
    match /reservations/{id} {
      allow create:               if true;
      allow read, update, delete: if signedIn();
    }

    // 방문 통계: 익명 방문자도 기록 생성, 열람/수정은 직원
    match /analytics_visits/{id} { allow create: if true; allow read, update, delete: if signedIn(); }
    match /analytics_events/{id} { allow create: if true; allow read, update, delete: if signedIn(); }
    match /analytics_daily/{id}  { allow read, write: if true; }  // 방문 카운터 트랜잭션(get+set)

    // ── 회원(홈페이지 로그인): 본인 문서만 읽기/쓰기, 관리자는 전체 조회 ──
    //    Google/이메일 로그인 시 users/{uid} 문서를 기록(merge)하므로 본인 uid만 허용.
    match /users/{uid} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── 상담 차팅 v2 (신규 포함) ──
    match /visits/{id}                        { allow read, write: if signedIn(); }
    match /visits/{visitId}/followups/{fu}    { allow read, write: if signedIn(); }
    match /procedures/{id}                    { allow read, write: if signedIn(); }
    match /vouchers/{id}                       { allow read, write: if signedIn(); }
    match /inventoryTransactions/{id}         { allow read, write: if signedIn(); }
    match /recipes/{id}                        { allow read, write: if signedIn(); }

    // ── 재고 ──
    match /inventory/{id}                      { allow read, write: if signedIn(); }
    match /inventoryLogs/{id}                  { allow read, write: if signedIn(); }
    match /inventoryAudits/{id}                { allow read, write: if signedIn(); }
    match /receiveHistory/{id}                 { allow read, write: if signedIn(); }
    match /receivingHistory/{id}               { allow read, write: if signedIn(); }
    match /locations/{id}                      { allow read, write: if signedIn(); }
    match /vendors/{id}                        { allow read, write: if signedIn(); }
    match /purchaseRequests/{id}               { allow read, write: if signedIn(); }
    match /suppliesCatalogLinks/{id}           { allow read, write: if signedIn(); }
    match /suppliesCatalogCustom/{id}          { allow read, write: if signedIn(); }
    match /categoryRules/{id}                  { allow read, write: if signedIn(); }
    match /productRatings/{id}                  { allow read, write: if signedIn(); }
    match /procedureTimes/{id}                  { allow read, write: if signedIn(); }
    match /injectionMixes/{id}                  { allow read, write: if signedIn(); }

    // ── 인사·근태·급여 ──
    match /employees/{id}                      { allow read, write: if signedIn(); }
    match /attendance/{id}                     { allow read, write: if signedIn(); }
    match /leaveRequests/{id}                  { allow read, write: if signedIn(); }
    match /lunchOT/{id}                         { allow read, write: if signedIn(); }
    match /mealRecords/{id}                     { allow read, write: if signedIn(); }
    match /payroll/{id}                         { allow read, write: if signedIn(); }
    match /incentiveItems/{id}                 { allow read, write: if signedIn(); }
    match /incentiveRecords/{id}               { allow read, write: if signedIn(); }
    match /monthlyIncentiveInput/{id}          { allow read, write: if signedIn(); }

    // ── 급여명세서: 본인 또는 관리자만 조회, 관리자만 쓰기 ──
    //    ⚠️ signedIn() 만으로 열면 타인 명세서가 노출되므로 반드시 소유자 검사.
    //    authEmail(업로드 시 저장한 직원 로그인 이메일) == 로그인 토큰 이메일 인 문서만 읽기.
    match /payslips/{id} {
      allow read: if signedIn()
        && (resource.data.authEmail == request.auth.token.email || isAdmin());
      allow write: if isAdmin();
    }

    // ── 매출·비용·세무 ──
    match /revenue/{id}                        { allow read, write: if signedIn(); }
    match /salesDetail/{id}                     { allow read, write: if signedIn(); }
    match /fixedExpenses/{id}                   { allow read, write: if signedIn(); }
    match /variableExpenses/{id}                { allow read, write: if signedIn(); }
    match /cards/{id}                           { allow read, write: if signedIn(); }
    match /incomeTaxes/{id}                     { allow read, write: if signedIn(); }
    match /vatTaxes/{id}                        { allow read, write: if signedIn(); }
    match /withholdingTaxes/{id}                { allow read, write: if signedIn(); }

    // ── 공지·교육/인계·상담 트리·설정·관리자 ──
    match /notices/{id}                         { allow read, write: if signedIn(); }
    match /clinicSchedule/{id}                  { allow read, write: if signedIn(); }  // 병원 진료일정(공휴일·자체휴무·대체진료), 문서ID=YYYY-MM-DD
    match /handovers/{id}                       { allow read, write: if signedIn(); }
    match /consultTreeBackups/{id}              { allow read, write: if signedIn(); }

    // 설정: 홈페이지 공개 콘텐츠 문서만 비로그인 읽기 허용, 나머지(bizAdmins 등)는 직원 전용
    match /settings/{docId} {
      allow read: if signedIn()
        || docId in ['treatmentMenu','heroSlider','spaceGallery','schedule',
                     'feeInfo','pageLayout','gallery','clinicHours'];
      allow write: if signedIn();
    }

    match /config/{id}                          { allow read, write: if signedIn(); }
    match /admins/{id}                          { allow read, write: if signedIn(); }

    // ── 고객 채팅 (카카오·네이버) ──
    match /chatThreads/{id}                     { allow read, write: if signedIn(); }
    match /chatThreads/{threadId}/messages/{m}  { allow read, write: if signedIn(); }

    // ── 레거시/호환 (기존 규칙 유지) ──
    match /patients/{id}                        { allow read, write: if signedIn(); }
    match /channels/{id}                        { allow read, write: if signedIn(); }
    match /treatments/{id}                       { allow read: if true; allow write: if signedIn(); }  // 홈페이지 예약페이지가 시술목록을 공개로 읽음
    match /feeSchedule/{id}                      { allow read, write: if signedIn(); }

    // 위 화이트리스트에 없는 모든 경로는 기본 거부(명시적으로 차단)
    match /{document=**}                        { allow read, write: if false; }
  }
}
