rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  재고닥 — 멀티테넌시 접근 통제
//  ---------------------------------------------------------------------------
//  원칙 하나: 모든 병원 데이터는 clinics/{clinicId}/ 아래에만 산다.
//  최상위 컬렉션은 users / clinics / invites 셋뿐이고, 그 밖의 것은 없다.
//  루미(firestore.rules)가 최상위 컬렉션 31개로 자란 뒤 멀티테넌시를 못 붙이게
//  된 것이 이 규칙의 이유다. 처음부터 막아 둔다.
//
//  소속 판정은 Custom Claims 로 한다.
//    request.auth.token.clinicId  — 소속 병원
//    request.auth.token.role      — owner | manager | staff
//  Firestore 문서를 읽어 판정하지 않는다. get() 은 규칙 호출마다 과금되고
//  느려서, 목록 하나 그리는 데 문서 수만큼 곱해진다.
//
//  ⚠️ 클레임은 최대 1 시간 묵을 수 있다.
//     권한을 바꾼 직후에는 클라이언트가 getIdToken(true) 로 강제 갱신해야 한다.
//     (public/auth.js 의 refreshClaims() 가 그 일을 한다)
//
//  ⚠️ 여기에 업무 규칙을 넣지 않는다.
//     "재고는 음수가 될 수 없다" 같은 것은 Rules 가 아니라 코드에서 막는다.
//     Rules 에 로직이 쌓이면 다른 백엔드로 옮길 때 통째로 다시 써야 한다.
//     Rules 가 답하는 질문은 하나다 — "이 사람이 이 병원 사람인가?"
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 판정 함수 ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    // 이 사람이 cid 병원 소속인가
    function member(cid) {
      return signedIn()
        && claims().clinicId is string
        && claims().clinicId == cid;
    }

    function role() {
      return signedIn() && claims().role is string ? claims().role : '';
    }

    function memberWithRole(cid, roles) {
      return member(cid) && role() in roles;
    }

    // 문서가 소속을 바꿔치기하지 못하게 한다.
    // 하위 컬렉션이라 경로로 이미 갈라지지만, clinicId 필드를 들고 있는 문서가
    // 다른 병원 값을 적어 두면 나중에 collectionGroup 질의에서 샌다.
    function clinicIdMatches(cid) {
      return !('clinicId' in request.resource.data)
        || request.resource.data.clinicId == cid;
    }

    // ── users ─────────────────────────────────────────────────────────────
    // 본인 프로필. 소속·권한은 Functions 만 쓴다 (클라이언트가 쓰면 권한 상승)

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && !('clinicId' in request.resource.data)
        && !('role' in request.resource.data);

      // 이름·전화 같은 것만 본인이 고친다. 소속·권한 필드는 손댈 수 없다.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['displayName', 'phone', 'photoURL', 'updatedAt']);

      allow delete: if false;   // 탈퇴는 Functions 가 처리한다
    }

    // ── clinics ───────────────────────────────────────────────────────────

    match /clinics/{clinicId} {
      allow read: if member(clinicId);

      // 병원 생성·삭제는 Functions 만. 클라이언트가 만들면 클레임과 어긋난다.
      allow create, delete: if false;

      // 병원 설정은 owner·manager 만. 요금제 필드는 아무도 못 고친다.
      allow update: if memberWithRole(clinicId, ['owner', 'manager'])
        && !request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(['plan', 'planExpiresAt', 'ownerUid', 'createdAt']);

      // ── 병원 데이터 ─────────────────────────────────────────────────────
      // 읽기는 소속이면 누구나. 재고는 직원이 다 봐야 일이 된다.

      match /items/{itemId} {
        allow read: if member(clinicId);
        allow create, update: if member(clinicId) && clinicIdMatches(clinicId);
        allow delete: if memberWithRole(clinicId, ['owner', 'manager']);
      }

      // 입출고 원장 — 고쳐 쓰지 않는다. 잘못 넣었으면 반대 전표를 넣는다.
      // 원장을 수정할 수 있으면 재고 숫자의 근거가 사라진다.
      match /movements/{movementId} {
        allow read: if member(clinicId);
        allow create: if member(clinicId) && clinicIdMatches(clinicId);
        allow update, delete: if false;
      }

      match /locations/{locationId} {
        allow read: if member(clinicId);
        allow write: if memberWithRole(clinicId, ['owner', 'manager']);
      }

      match /vendors/{vendorId} {
        allow read: if member(clinicId);
        allow create, update: if member(clinicId) && clinicIdMatches(clinicId);
        allow delete: if memberWithRole(clinicId, ['owner', 'manager']);
      }

      // 명세서 원본 — OCR 결과가 여기 붙는다 (P2)
      match /purchaseDocs/{docId} {
        allow read: if member(clinicId);
        allow create, update: if member(clinicId) && clinicIdMatches(clinicId);
        allow delete: if memberWithRole(clinicId, ['owner', 'manager']);
      }

      match /counts/{countId} {          // 실사
        allow read: if member(clinicId);
        allow create, update: if member(clinicId) && clinicIdMatches(clinicId);
        allow delete: if memberWithRole(clinicId, ['owner', 'manager']);
      }

      // 직원 명부 — 읽기는 소속 전원, 쓰기는 Functions 만.
      // 여기서 권한을 고칠 수 있으면 클레임과 어긋난 두 개의 진실이 생긴다.
      match /members/{memberUid} {
        allow read: if member(clinicId);
        allow write: if false;
      }

      match /settings/{docId} {
        allow read: if member(clinicId);
        allow write: if memberWithRole(clinicId, ['owner', 'manager']);
      }

      // 위에 안 적힌 하위 경로는 전부 막는다.
      // 새 컬렉션을 쓰려면 여기에 먼저 추가해야 한다 — 잊고 배포하면 앱이
      // 막히므로 바로 알아챈다. 조용히 열려 있는 것보다 낫다.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ── invites ───────────────────────────────────────────────────────────
    // 초대 코드. 가입 전 사용자는 소속이 없어 member() 로 판정할 수 없다.
    // 그래서 문서 id 를 추측 불가능한 난수로 만들고, 그것을 아는 것 자체를
    // 권한으로 쓴다. 목록 조회(list)는 막혀 있으므로 훑어볼 수 없다.

    match /invites/{inviteId} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;            // 생성·소진 모두 Functions
    }

    // ── 그 밖의 최상위 경로 ────────────────────────────────────────────────
    // 전부 막는다. 병원 데이터는 clinics/{clinicId}/ 아래로만 간다.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
