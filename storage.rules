rules_version = '2';

// The Clinic Lumi — Firebase Storage 보안 규칙
// firestore.rules 와 동일하게 main 푸시 시 GitHub Actions로 자동 배포됩니다.
//
// 원칙:
//  - 공개 사이트(lumiclinic.co.kr)가 익명으로 이미지를 표시해야 하므로 읽기는 공개
//  - 업로드/수정/삭제는 로그인한(직원) 사용자만
//  - 단, 급여명세서(payslips/)는 예외로 본인·관리자만
//
// ⚠️ 규칙 평가 방식 주의
//   Storage 규칙은 "매칭되는 규칙 중 하나라도 허용하면 허용" 이다.
//   따라서 아래 공개 와일드카드에 payslips/ 를 그냥 두면, 급여명세서에 아무리
//   엄격한 하위 규칙을 붙여도 공개 읽기가 그대로 통과한다.
//   그래서 와일드카드 쪽에서 payslips/ 를 명시적으로 제외한다.

service firebase.storage {
  match /b/{bucket}/o {

    // ── 급여명세서 ──
    // 경로: payslips/{소문자 로그인 이메일}/{난수}_{파일명}
    //
    // 공개 읽기에서 반드시 빠져야 한다(급여 정보). 여기서는 "로그인" 까지만 보고,
    // 본인/관리자 구분은 Firestore 가 맡는다:
    //   · 파일을 여는 열쇠(다운로드 URL)는 payslips 문서 안에만 들어 있고,
    //     그 문서는 firestore.rules 가 authEmail 본인 또는 관리자에게만 열어 준다.
    //   · 경로에 난수를 넣어 URL 을 모르면 파일을 짚어낼 수 없게 한다.
    //
    // 규칙만으로 "본인 또는 관리자" 를 표현하려면 관리자 판별이 필요한데,
    // settings/bizAdmins 를 보는 cross-service 규칙(firestore.get)은 에뮬레이터에서
    // 동작하지 않아 검증할 수 없었다. 검증 못 한 조건을 급여 파일에 걸면
    // 관리자 업로드가 통째로 막힐 수 있어, 확실히 동작하는 선까지만 건다.
    // (다음 단계: 관리자에게 커스텀 클레임을 부여해 규칙에서 직접 판별)
    match /payslips/{ownerEmail}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // ── 그 외 (홈페이지 이미지 등) ──
    // payslips/ 는 위 규칙만 적용되도록 여기서 제외한다.
    // 첫 폴더명을 따로 묶어야 비교할 수 있다. ({x=**} 는 경로(Path)라
    // matches() 같은 문자열 함수를 쓸 수 없다 — 에뮬레이터로 확인함)
    match /{prefix}/{rest=**} {
      allow read:  if prefix != 'payslips';
      allow write: if request.auth != null && prefix != 'payslips';
    }

    // 폴더 없이 최상위에 바로 올라간 파일
    match /{fileName} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
